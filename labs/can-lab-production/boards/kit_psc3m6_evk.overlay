/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PSOC Control CAN Command & Telemetry lab - devicetree overlay for
 * KIT_PSC3M6_EVAL (PSOC Control C3M6 Evaluation Kit).
 *
 * Shared by both roles (Command node and Telemetry node); only the
 * application code built on top differs.
 *
 * The board devicetree already describes everything this lab drives:
 *
 *   - CAN FD on canfd0/can1 (P5.2 RX, P5.3 TX) with a can-transceiver-gpio
 *     node (can_phy0, standby on P12.5).
 *   - The on-board potentiometer as SAR ADC channel 12 on AN_B4, including
 *     gain, reference, resolution and acquisition time.
 *   - A hardware PWM output on P5.0 (tcpwm0_6 / pwm0_6) with its peripheral
 *     clock divider and push-pull pinctrl.
 *
 * This overlay nominates which of those the application consumes.
 *
 * Docs: what an overlay is and why it exists
 *   https://docs.zephyrproject.org/latest/build/dts/intro.html
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	/*
	 * The Command node reads the potentiometer to produce its setpoint.
	 * ADC channel 12 is the pot, on AN_B4 - the first input of mux
	 * sampler 0.
	 */
	zephyr,user {
		io-channels = <&adc0 12>;
	};

	aliases {
		cmd-pwm = &pwm_cmd;
	};

	/*
	 * Command PWM output on P5.0, brought out on header J21 pin 11, next
	 * to the CAN pins (P5.2/P5.3). It is an ordinary signal pin, safe to
	 * probe or to drive a 2-pin LED harness (GND is on J21 pin 2).
	 */
	pwmleds {
		compatible = "pwm-leds";

		pwm_cmd: pwm_cmd_led {
			label = "Command PWM output (P5.0)";
			pwms = <&pwm0_6 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
	};
};
