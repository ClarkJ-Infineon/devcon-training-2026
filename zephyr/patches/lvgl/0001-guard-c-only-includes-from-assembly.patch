From: DevCon Training <devcon@example.invalid>
Subject: [PATCH] lvgl: guard C-only includes from assembly

lv_conf.h pulls in C headers that the Helium assembly sources cannot
parse. Wrap them so assembly translation units see only the macros.

---
diff --git a/src/lvgl_public.h b/src/lvgl_public.h
index ce41429af..3e8883e0e 100644
--- a/src/lvgl_public.h
+++ b/src/lvgl_public.h
@@ -1,7 +1,10 @@
 #ifndef LVGL_PUBLIC_H
 #define LVGL_PUBLIC_H
 
-/*Include every public header*/
-#include "../include/lvgl/lvgl.h"
+#ifndef __ASSEMBLY__
+    #include "../include/lvgl/lvgl.h"
+#else
+    #include "../include/lvgl/config/lv_conf_internal.h"
+#endif /*__ASSEMBLY__*/
 
 #endif /*LVGL_PUBLIC_H*/
