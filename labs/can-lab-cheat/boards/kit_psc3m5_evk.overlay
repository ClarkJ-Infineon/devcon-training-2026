/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PSOC Control CAN Command & Telemetry lab - devicetree overlay
 * (skeleton).
 *
 * This overlay is shared by both roles (Command node and Telemetry node) -
 * the physical board is identical either way, only the application code
 * built on top of it differs.
 *
 * CAN is already enabled by default in this board's base devicetree
 * (kit_psc3m5_evk-common.dtsi enables canfd0/can1, and `zephyr,canbus` is
 * already chosen). The `can_phy` node below is provided for you - it works
 * around a gap in the board support package (see the comment on that node).
 * Your two devicetree touchpoints in this lab are:
 *
 *   TODO 1a/1b: enable the onboard potentiometer's ADC channel.
 *   TODO 1c:    enable the PWM output used for the brightness command
 *               signal (mikroBUS header 1 / pin P4.0).
 *
 * Reference: samples/drivers/adc/adc_dt/boards/kit_psc3m5_evk.overlay and
 * samples/basic/fade_led/boards/kit_psc3m5_evk.overlay in the Zephyr
 * tree show the same nodes fully enabled, if you get stuck.
 *
 * Docs: what an overlay is and why it exists
 *   https://docs.zephyrproject.org/latest/build/dts/intro.html
 * Every property you can legally set on a node is defined by its binding,
 * and all of the in-tree bindings are published here - searching this page
 * for a `compatible` string is the fastest way to answer "what goes in
 * this node?":
 *   https://docs.zephyrproject.org/latest/build/dts/api/bindings.html
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/pwm_ifx_tcpwm.h>

/ {
	/*
	 * TODO 1a: Uncomment the io-channels property below so the
	 * application can request the potentiometer channel by name. The
	 * onboard potentiometer is wired to HPPASS SAR ADC channel 12
	 * (this is "CYBSP_POT" in the ModusToolbox BSP for this board).
	 *
	 * Docs: how `io-channels` ties an application to an ADC channel, and
	 * what ADC_DT_SPEC_GET() does with it:
	 *   https://docs.zephyrproject.org/latest/hardware/peripherals/adc.html
	 */
	zephyr,user {
		io-channels = <&adc0 12>;
	};

	aliases {
		/*
		 * TODO 1c (cont'd): alias the PWM LED node below so the
		 * application's DT_ALIAS(cmd_pwm) resolves.
		 */
		cmd-pwm = &pwm_cmd;
	};

	/*
	 * Provided for you - not a lab task.
	 *
	 * The CAN screw terminals are fed by an onboard TLE9251VLEXUMA1
	 * transceiver whose STB (standby) pin is on P7.6. STB has an internal
	 * pull-up, so the transceiver powers up in STANDBY with its
	 * transmitter disabled - the node cannot even acknowledge frames.
	 * The upstream board devicetree does not model the transceiver, so
	 * without this node nothing releases STB, every transmission goes
	 * unacknowledged, and the controller is driven bus-off within about
	 * a millisecond (can_send() returns -ENETUNREACH).
	 *
	 * Modelling it here lets Zephyr's CAN core drive STB low on
	 * can_start() and release it on can_stop().
	 */
	can_phy: can-phy {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&gpio_prt7 6 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_cmd: pwm_cmd_led {
			label = "Command PWM output (mikroBUS 1 / P4.0)";
			pwms = <&pwm1_4 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
	};
};

&adc0 {
	/*
	 * TODO 1a (cont'd): enable the HPPASS SAR ADC controller itself.
	 */
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * TODO 1b: describe ADC channel 12 (12-bit resolution, internal
	 * reference, default acquisition time). Uncomment the block below.
	 *
	 * Docs: the `zephyr,gain` / `zephyr,reference` / `zephyr,resolution`
	 * properties are generic ADC channel properties, explained here:
	 *   https://docs.zephyrproject.org/latest/hardware/peripherals/adc.html
	 */
	channel@c {
		reg = <12>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <12>;
	};
};

&tcpwm1_4 {
	/*
	 * TODO 1c (cont'd): enable this TCPWM instance and its pwm1_4
	 * child, and route it out to pin P4.0 (mikroBUS header 1).
	 *
	 * Docs: the PWM subsystem and its devicetree model
	 *   https://docs.zephyrproject.org/latest/hardware/peripherals/pwm.html
	 */
	status = "okay";

	pwm1_4: pwm1_4 {
		status = "okay";
		clocks = <&peri0_group5_16bit_0>;
		pinctrl-0 = <&p4_0_pwm1_4>;
		pinctrl-names = "default";
	};
};

/*
 * 240 divides the 240 MHz peripheral clock to a 1 MHz counter, giving the
 * 1 kHz PWM exactly 1000 brightness steps. 1 kHz is deliberate: at 50 Hz a
 * single disturbed period lasts 20 ms, which is visible as a bright flash
 * while the duty cycle is changing quickly.
 */
&peri0_group5_16bit_0 {
	status = "okay";
	clock-div = <240>;
};

&pinctrl {
	p4_0_pwm1_4: p4_0_pwm1_4 {
		drive-push-pull;
	};
};

&gpio_prt4 {
	status = "okay";
};

/* Required so the transceiver's STB pin (P7.6) can be driven. */
&gpio_prt7 {
	status = "okay";
};

&can1 {
	phys = <&can_phy>;
};
