/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PSOC Control CAN Command & Telemetry lab - trigger-mux LED overlay
 * ("Option A", real hardware PWM on the on-board LED).
 *
 * Applied automatically on top of kit_psc3m5_evk.overlay when the
 * application is built with -DLED_TRIGMUX=y (see CMakeLists.txt).
 *
 * Adds the pin-mux half of the trigger-mux route: P8.5 (LED0) is switched
 * from plain GPIO to its PERI_TR_IO_OUTPUT43 HSIOM option, so the trigger
 * mux output made by Cy_TrigMux_Connect() in src/lab_led_trigmux.c actually
 * reaches the pin.
 *
 * The new pin is appended to the PWM channel's own pinctrl-0 state so that
 * the TCPWM driver applies it during its normal initialisation - no extra
 * device or driver is needed.
 */

#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>

&pinctrl {
	/*
	 * HSIOM_SEL_ACT_15 is mode 27, which on P8.5 selects
	 * PERI_TR_IO_OUTPUT43.
	 */
	p8_5_tr_io_output43: p8_5_tr_io_output43 {
		pinmux = <DT_CAT1_PINMUX(8, 5, HSIOM_SEL_ACT_15)>;
		drive-push-pull;
	};
};

&gpio_prt8 {
	status = "okay";
};

&pwm1_4 {
	pinctrl-0 = <&p4_0_pwm1_4 &p8_5_tr_io_output43>;
	pinctrl-names = "default";
};
