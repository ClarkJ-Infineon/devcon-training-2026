/*
 * GPU overlay for the E84 display lab. Use together with gpu.conf.
 *
 * Binds LVGL's vg_lite draw unit to the GCNanoUltraV and enlarges
 * GFX_MEMORY, which must now hold the vg_lite command and tessellation
 * heap alongside the draw buffers and the LVGL memory pool.
 */

/ {
	lvgl_vglite {
		compatible = "zephyr,lvgl-gpu-vglite";
		gpu = <&gcnano>;
		variant = "gcnanoultrav";
		revision = "0x1003";
	};
};

&gcnano {
	status = "okay";
};

/* 2 MB in the board overlay is enough for the plain framebuffer path only. */
&gfx_mem {
	reg = <0x26140000 DT_SIZE_K(3584)>;
};