/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PSOC Control CAN Command & Telemetry lab - devicetree overlay for
 * KIT_PSC3M5_CC2 (the MCU card inside the KIT_PSC3M5_MC1 motor-control kit).
 *
 * Shared by both roles (Command node and Telemetry node); only the
 * application code built on top differs.
 *
 * =====================================================================
 * HARDWARE-VALIDATED ON A REAL KIT_PSC3M5_CC2 (2026-09-22)
 * =====================================================================
 *
 * Boot, console, J-Link flashing and the ADC pot channel have all been
 * confirmed on physical hardware. The CAN chain is resolved from the
 * schematic and needs no devicetree transceiver node.
 *
 * P9.0 is net V2_H, a motor 2 inverter gate-drive signal on the Power Board
 * Connector X19. With no power board attached, X19 is an access header, so
 * the hardware-PWM node below is reachable with a probe or a 2-pin LED
 * harness. NEVER run this lab with a motor-control power board fitted.
 *
 * Hardware PWM still cannot reach an on-board LED: the user LEDs are on
 * P9.4/P9.5, which have no TCPWM option, so the lab keeps its software PWM.
 *
 * Everything here is derived from verified sources or measured on the board.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/pwm_ifx_tcpwm.h>

/ {
	/*
	 * ==================================================================
	 * HPPASS SAR potentiometer channel - CONFIRMED ON HARDWARE
	 * ==================================================================
	 *
	 * Channel 12 is correct. This was measured on a real board on
	 * 2026-09-22, not inferred.
	 *
	 * The KIT_PSC3M5_CC2 ModusToolbox BSP routes the two pots to
	 *
	 *     pass[0].sar[0].muxed_sampler[0]   (CYBSP_POT / POT1)
	 *     pass[0].sar[0].muxed_sampler[1]   (CYBSP_POT2)
	 *
	 * Those are sampler indices, not channel numbers. Channels 12-15 are
	 * multiplexed onto sampler 0 and 16-19 onto sampler 1
	 * (adc_infineon_hppass_sar.c:115), so channel = 12 + 4*sampler + mux,
	 * giving POT1 = 12 and POT2 = 16, both on mux input 0 - the same
	 * input the other PSOC Control kits use.
	 *
	 * ------------------------------------------------------------------
	 * READ THIS BEFORE "FIXING" THIS NUMBER
	 * ------------------------------------------------------------------
	 * An on-board scan that declares channels 12..19 in one sequence will
	 * appear to show the pot on channel 13, not 12. That reading is an
	 * artefact of the driver, not the board. In a multi-channel sequence
	 * the results come back shifted by one position: the value printed
	 * for position N is the conversion of position N-1. Reordering the
	 * scan proved it - the full-scale reading followed the scan position,
	 * never the channel number.
	 *
	 * A single-channel build (only channel 12 declared) reads the pot
	 * correctly, because with one channel a shifted result is still that
	 * same channel. The lab only ever reads one channel, so it is not
	 * affected. See findings.md section 7.2.
	 */

	zephyr,user {
		io-channels = <&adc0 12>;
	};

	aliases {
		cmd-pwm = &pwm_cmd;
	};

	/*
	 * ==================================================================
	 * CAN transceiver control - nothing for software to do
	 * ==================================================================
	 *
	 * The CAN front end on KIT_PSC3M5_CC2 is galvanically isolated, so
	 * the signal passes through one more link than it would on a
	 * non-isolated board:
	 *
	 *   P6.3 CAN1_TX --> INA  ==||== OUTA --> TXD --+ TLE9371VSJ +-- CANH
	 *   P6.2 CAN1_RX <-- OUTB ==||== INB  <-- RXD --+  STB = GND +-- CANL
	 *                     2DIB1400F
	 *                  dual digital isolator
	 *
	 * Confirmed from the schematic:
	 *
	 *   - Pin direction matches this board's ModusToolbox BSP exactly:
	 *     P6.3 = CYBSP_CAN_TX, P6.2 = CYBSP_CAN_RX. Two independent
	 *     sources agree, so the pinctrl below is not an assumption.
	 *
	 *   - The TLE9371VSJ STB pin is tied DIRECTLY TO GND (the isolated
	 *     ground). STB is active high, so a hard ground means the
	 *     transceiver is permanently in normal mode.
	 *
	 * Consequences, and they are good ones:
	 *
	 *   - NO can-transceiver-gpio node is needed, and no `phys` property
	 *     on &can1. There is nothing for software to enable.
	 *
	 *   - The classic "bus-off ~1 ms after boot with the error counters
	 *     still reading zero" failure - a transceiver left in standby
	 *     because its STB pull-up was never released - cannot happen
	 *     here. It is designed out in hardware.
	 *
	 *   - The CAN path does not depend on a GPIO device being ready, so
	 *     GPIO driver init ordering cannot affect it either. The board's
	 *     Kconfig.defconfig still sets CAN_TRANSCEIVER_INIT_PRIORITY=55
	 *     defensively, for any future application that does add one.
	 *
	 * Validated on hardware: two boards, CANH/CANL/GND wired directly
	 * between them, no external supply or termination fitted. The
	 * isolated side is powered from the board and the link comes up.
	 */

	pwmleds {
		compatible = "pwm-leds";

		/*
		 * Command PWM output on P9.0.
		 *
		 * P9.0 is schematic net V2_H: motor 2, phase V, high-side
		 * gate drive, brought out on the Power Board Connector X19.
		 * The ModusToolbox motor-demo BSP aliases it TEST_PIN0, but
		 * that is a software alias, not a physical test point.
		 *
		 * WARNING - driving this pin is safe only with no
		 * motor-control power board attached, which is how the lab is
		 * run. With a power board fitted it would command a gate
		 * driver.
		 *
		 * P9.0 was chosen because it is one of the few free pins on
		 * this board with a DIRECT TCPWM HSIOM option - the 80-pin
		 * GPIO table gives P9_0_TCPWM0_LINE518 = HSIOM option 10, no
		 * PERI trigger mux required. The obvious alternative, the
		 * mikroBUS PWM pin (P0.1 / CYBSP_MIKROBUS_PWM), does NOT have
		 * one: its only non-GPIO options are PERI_TR_IO_INPUT1 and
		 * PERI_TR_IO_OUTPUT1.
		 *
		 * This does not reach an on-board LED - the user LEDs are on
		 * P9.4/P9.5, whose only non-GPIO HSIOM options are SCB0 SPI
		 * selects. Every pin on this board that does have a TCPWM
		 * route is inverter gate drive, so the lab keeps its software
		 * PWM for the on-board LED. That is the correct choice here,
		 * not a workaround.
		 */
		pwm_cmd: pwm_cmd_led {
			label = "Command PWM output (P9.0 / V2_H on X19)";
			pwms = <&pwm2_6 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		};
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* POT1. Confirmed on hardware 2026-09-22 - see the block above. */
	channel@c {
		reg = <12>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <12>;
	};
};

&tcpwm2_6 {
	status = "okay";

	pwm2_6: pwm2_6 {
		status = "okay";
		clocks = <&peri0_group5_16bit_0>;
		pinctrl-0 = <&p9_0_pwm2_6>;
		pinctrl-names = "default";
	};
};

/*
 * tcpwm2_6 has clk-dst = <0x512>, i.e. peripheral group 5. The divider is
 * shared with &csg0, which the board dtsi sets to 2.
 *
 * 240 divides the 240 MHz peripheral clock to a 1 MHz counter, giving the
 * 1 kHz PWM above exactly 1000 brightness steps.
 *
 * This replaces an earlier 9600 (25 kHz counter, 50 Hz PWM). 50 Hz was slow
 * enough to see: measured on hardware 2026-10-02, the output flashed brightly
 * whenever the duty cycle changed quickly, because one disturbed period lasts
 * a full 20 ms. The TCPWM itself was cleared of blame first - CC0 and CC0_BUFF
 * tracked every request exactly and the counter was never restarted - so the
 * fix is the frequency, not the driver. At 1 kHz the same fade is smooth. */
&peri0_group5_16bit_0 {
	status = "okay";
	clock-div = <240>;
};

&pinctrl {
	p9_0_pwm2_6: p9_0_pwm2_6 {
		drive-push-pull;
	};
};

/* P9.0 (PWM, net V2_H) and P9.4/P9.5 (user LEDs). */
&gpio_prt9 {
	status = "okay";
};

/*
 * NOTE - no `phys` property and no transceiver node, deliberately.
 *
 * The TLE9371VSJ STB pin is hardwired to the isolated ground, so the
 * transceiver is always in normal mode and there is nothing for software to
 * enable. Adding a can-transceiver-gpio node here would be describing
 * hardware that does not exist. &can1 is enabled by the board dtsi and needs
 * no override.
 *
 * ---------------------------------------------------------------------
 * RESOLVED (measured on hardware, 2026-09-24) - 2DIB1400F fail-safe state
 * ---------------------------------------------------------------------
 *
 * Between the MCU and the transceiver sits a 2DIB1400F digital isolator.
 * Earlier datasheet review recorded its default output state as LOW, which
 * would have meant a latent hazard:
 *
 *     P6.3 undriven  ->  INA floating  ->  OUTA LOW  ->  TXD LOW
 *                     ->  transceiver drives a PERMANENT DOMINANT bit
 *
 * A stuck-dominant node does not merely fail itself, it jams the bus for
 * every other node on it. P6.3 is undriven from power-on until the CAN
 * driver applies pinctrl, and indefinitely if the board is unprogrammed,
 * held in reset, or halted at a debugger breakpoint before CAN init.
 *
 * THE HAZARD DOES NOT EXIST ON THIS BOARD. Measured with two boards on one
 * bus, no multimeter required. One board was held in its post-reset halted
 * state (JLink: connect / r / h / Sleep), which is the exact worst case -
 * peripherals reset, CAN pins back to Hi-Z inputs, isolator input undriven.
 * It was confirmed genuinely held by its console going completely silent.
 *
 * The surviving board then reported, once every 5 s:
 *
 *     CAN send failed (-11) state=2 tx_err=0 rx_err=123 (601 dropped)
 *
 * state=2 is CAN_STATE_ERROR_PASSIVE, not CAN_STATE_BUS_OFF (3), and the
 * error counters stayed pinned at 123 across four samples 15 s apart while
 * only the dropped counter advanced. That is the signature of losing the
 * ACK partner. A bus held dominant would instead produce continuous bit
 * errors, runaway counters and bus-off. So the isolator output does NOT
 * idle dominant when its input is undriven.
 *
 * Recovery is automatic: on release the held board rebooted, the link came
 * back with no power cycle and no intervention, and a following 15 s window
 * logged zero warnings on either node. An attendee can therefore reset or
 * reflash one board mid-lab without disturbing their partner's board beyond
 * a transient warning that clears itself.
 *
 * No devicetree mitigation is needed. This also means the rejected fix -
 * adding `bias-pull-up` to p6_3_can1_tx, which risked conflicting with
 * `drive-push-pull` in the Infineon cat1 pinctrl binding where drive mode
 * is a single register field rather than independent flags - stays
 * correctly rejected, now for a measured reason rather than caution.
 */